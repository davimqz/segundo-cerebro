# Copie para /opt/asttra/paperclip/.env no servidor, com permissão 600 e dono root.
# O .env nunca vai para o Git.
#
# Já ficam fixos no compose.yml (não precisa repetir aqui): PAPERCLIP_DEPLOYMENT_MODE=authenticated,
# PAPERCLIP_DEPLOYMENT_EXPOSURE=private, PAPERCLIP_TELEMETRY_DISABLED=1, DO_NOT_TRACK=1 e
# PAPERCLIP_MIGRATION_AUTO_APPLY=true.
# Não configure SENTRY_DSN, OTEL_*, PAPERCLIP_CLOUD_* nem chaves de modelos pagos.

# Versão fixa do Paperclip (tag do GitHub), usada no nome da imagem local.
# Trocar de versão é um passo manual (ver o playbook, "Trocar a versão do Paperclip").
PAPERCLIP_VERSAO=v2026.1023.0
# Imagem oficial da mesma versão, fixada pelo digest (ADR 0006). Para achar o digest de uma versão:
#   docker buildx imagetools inspect ghcr.io/paperclipai/paperclip:<versão sem o v>   (linha "Digest")
PAPERCLIP_IMAGEM=ghcr.io/paperclipai/paperclip:2026.1023.0@sha256:40f46940c4612ead131aebe6079cd4651f8cd1434af49f7c621887f4a452a62e

# Conexão com o banco "paperclip" (senha PAPERCLIP_DB_PASSWORD de /opt/asttra/banco/.env).
# Dentro da rede Docker o host é "postgres".
DATABASE_URL=postgres://paperclip:SENHA@postgres:5432/paperclip

# Segredos. Gere cada um com: openssl rand -hex 32  (um valor diferente para cada)
BETTER_AUTH_SECRET=
PAPERCLIP_AGENT_JWT_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# Endereço público (com https), atrás do Cloudflare Tunnel e do Access.
PAPERCLIP_PUBLIC_URL=https://agentes.exemplo.com.br
PAPERCLIP_AUTH_PUBLIC_BASE_URL=https://agentes.exemplo.com.br
# Só o nome, sem https. Separe vários com vírgula. "paperclip" é o nome na rede interna "asttra",
# usado pelo Hermes (spec 005); sem ele, o Paperclip responde 403 às chamadas do Hermes.
PAPERCLIP_ALLOWED_HOSTNAMES=agentes.exemplo.com.br,paperclip

# O Paperclip fica atrás de um proxy (o cloudflared): confia no X-Forwarded-*.
TRUST_PROXY=1

# Porta no 127.0.0.1 do servidor. Padrão: 18100.
PAPERCLIP_PORTA=18100

# Fuso horário dos logs.
TZ=America/Sao_Paulo
