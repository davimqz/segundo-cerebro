# Configuração da empresa no Paperclip, lida por configurar.sh e teste-aprovacao.sh.
# Copie para /opt/asttra/paperclip/configuracao.env no servidor. Não tem segredos.

# Nome da empresa no Paperclip.
PAPERCLIP_EMPRESA="Asttra Labs"

# Projetos, um por departamento, separados por vírgula, na ordem do painel.
# Enquanto o painel não tem a API /api/v1, a lista fica aqui (mesmos nomes da tabela departamentos).
PAPERCLIP_PROJETOS="Crescimento,Entrega,Clientes,Administração,Direção"

# Endereço da API do Paperclip visto do servidor (a porta do compose.yml).
PAPERCLIP_URL=http://127.0.0.1:18100

# Endereço público, usado no link de aprovação que o script mostra.
PAPERCLIP_URL_PUBLICA=https://agentes.exemplo.com.br
