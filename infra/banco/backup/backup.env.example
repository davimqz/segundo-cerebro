# Copie para backup.env no servidor (/opt/asttra/banco/backup/backup.env), com permissão 600 e dono root.

# Repositório restic no Cloudflare R2:
# s3:https://<ID_DA_CONTA>.r2.cloudflarestorage.com/asttra-backups
RESTIC_REPOSITORY=
# Senha de criptografia do restic. Guarde também no gerenciador de senhas:
# sem ela, nenhum backup pode ser restaurado. Gere com: openssl rand -hex 32
RESTIC_PASSWORD=
# Token de API do R2 com permissão de leitura e escrita só no bucket asttra-backups.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# URL de ping da checagem no Healthchecks.io (https://hc-ping.com/<uuid>).
HC_PING_URL=
