# Copie para .env no servidor (/opt/asttra/banco/.env), com permissão 600 e dono root.
# Gere cada senha com: openssl rand -hex 32
# Use só letras e números (o -hex garante isso): evita problemas de escape nas URLs de conexão.

# Superusuário do PostgreSQL (usuário postgres).
POSTGRES_PASSWORD=
# Usuários de cada serviço, um banco para cada.
PAINEL_DB_PASSWORD=
N8N_DB_PASSWORD=
PAPERCLIP_DB_PASSWORD=
# Senha única do Redis, compartilhada pelos serviços internos.
REDIS_PASSWORD=
