# Variáveis do Hermes (spec 005). Copie para /opt/asttra/hermes/.env no servidor, com chmod 600.
# Os segredos ficam vazios aqui e nunca vão para o Git.

# Imagem oficial, presa pelo digest (conferida na spec 005 e no ADR 0007).
HERMES_IMAGEM=nousresearch/hermes-agent:v0.22.7@sha256:e6d81ae52ebf6a43efa529701405509f20054ba818f179ddd748bed4f8af584c

# Modelo gratuito do OpenRouter (termina em :free). Escolhido pelo Davi na implantação, depois
# de ler os termos de dados (playbook, capítulo Hermes).
HERMES_MODELO=

# Quem fala com o Hermes (aparece nas instruções dele, o SOUL.md).
HERMES_DONO=Davi

# Chave do OpenRouter, de uma conta SEM créditos (assim nada pode ser cobrado).
OPENROUTER_API_KEY=

# Bot do Hermes, criado no @BotFather.
TELEGRAM_BOT_TOKEN=
# ID numérico do Telegram de quem pode falar com o Hermes (só o Davi). Vazio = ninguém.
TELEGRAM_ALLOWED_USERS=

# Chave da API do Hermes, que o Paperclip usa para chamá-lo. Gere com: openssl rand -hex 32
API_SERVER_KEY=

# Paperclip, visto de dentro da rede "asttra".
PAPERCLIP_API_URL=http://paperclip:3100
# Endereço público do Paperclip, para os links das tarefas.
PAPERCLIP_URL_PUBLICA=https://agentes.exemplo.com.br
# Chave de agente do Hermes no Paperclip. Gravada pelo configurar.sh; não preencha à mão.
PAPERCLIP_API_KEY=
