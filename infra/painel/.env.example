# Copie para /opt/asttra/painel/.env no servidor, com permissão 600 e dono root.
# O .env nunca vai para o Git.

# Conexão com o banco "painel" (senha PAINEL_DB_PASSWORD de /opt/asttra/banco/.env).
# Dentro da rede Docker o host é "postgres".
DATABASE_URL=postgres://painel:SENHA@postgres:5432/painel

# Segredo das sessões. Gere com: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Endereço público do painel (com https).
BETTER_AUTH_URL=https://painel.exemplo.com.br

# Nome mostrado no menu e no título das páginas.
PAINEL_NOME=

# Dias que a sessão dura desde o login (sem renovação pelo uso). Padrão: 1.
SESSAO_DIAS=1

# Porta no 127.0.0.1 do servidor. Padrão: 18000.
PAINEL_PORTA=18000

# Fuso horário das datas mostradas no painel.
TZ=America/Sao_Paulo

# Pasta do código do painel, usada no build (ADR 0005).
PAINEL_SRC=/opt/asttra/painel-src/painel
