{
  "name": "painel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unidade",
    "test:integracao": "vitest run --project integracao",
    "test:e2e": "playwright test",
    "db:gerar": "drizzle-kit generate",
    "db:migrar": "tsx --env-file-if-exists=.env scripts/migrar.ts",
    "usuario": "tsx --env-file-if-exists=.env scripts/usuario.ts",
    "aviso": "tsx --env-file-if-exists=.env scripts/aviso.ts",
    "build:scripts": "node scripts/empacotar.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "better-auth": "1.7.15",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  }
}
