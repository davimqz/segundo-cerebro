# Copie para painel/.env para rodar localmente (pnpm dev). Em produção, veja infra/painel/.env.example.
# O .env nunca vai para o Git.

# Conexão com o banco "painel" (senha PAINEL_DB_PASSWORD de /opt/asttra/banco/.env).
# Localmente, o PostgreSQL de infra/banco responde em 127.0.0.1:5432.
DATABASE_URL=postgres://painel:SENHA@127.0.0.1:5432/painel

# Segredo das sessões. Gere com: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Endereço do painel. Em produção, o público com https.
BETTER_AUTH_URL=http://localhost:3000

# Nome mostrado no menu e no título das páginas.
PAINEL_NOME=

# Dias que a sessão dura desde o login (sem renovação pelo uso). Padrão: 1.
SESSAO_DIAS=1

# Porta no 127.0.0.1 do servidor. Padrão: 18000.
PAINEL_PORTA=18000

# Fuso horário das datas mostradas no painel.
TZ=America/Sao_Paulo


# Aprovações (spec 006), opcionais. Veja infra/painel/.env.example.
PAPERCLIP_URL=http://127.0.0.1:18100
PAPERCLIP_EMPRESA_ID=
PAPERCLIP_CHAVE_BOARD=
TELEGRAM_APROVACOES_TOKEN=
TELEGRAM_APROVACOES_CHAT_ID=
